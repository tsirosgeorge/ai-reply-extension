{
  "manifest_version": 3,
  "name": "AI Comment Helper (DeepSeek)",
  "version": "1.2.0",
  "description": "AI βοηθός για σχόλια: βελτίωση κειμένου, μετάφραση ΕΛ/EN και αυτόματη απάντηση με βάση το post.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*",
        "https://*.linkedin.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*",
        "https://*.youtube.com/*",
        "https://*.threads.net/*",
        "https://*.threads.com/*",
        "https://facebook.com/*",
        "https://linkedin.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://instagram.com/*",
        "https://reddit.com/*",
        "https://youtube.com/*",
        "https://threads.net/*",
        "https://threads.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "AI Comment Helper – Ρυθμίσεις",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
